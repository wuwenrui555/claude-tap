# claude-tap settings.env (example)
#
# Copy to one of these locations and uncomment lines you want to set:
#   - $CLAUDE_TAP_DIR/settings.env  (default ~/.claude-tap/settings.env)
#   - ./settings.env                (cwd, project-local; takes priority)
#
# Shell-exported env vars always win over file values.
# Lines starting with # are comments.

# State directory (paths derive from here: events.jsonl, decision.sock, bin/claude).
# CLAUDE_TAP_DIR=~/.claude-tap

# Opaque consumer identifier stamped on every event.
# CLAUDE_TAP_SURFACE_ID=

# Synchronous PermissionRequest decision timeout (seconds).
# CLAUDE_TAP_DECISION_TIMEOUT=120

# Polling cadence (seconds) for events.jsonl tail AND the scoped
# post-tool-use polling task in MessageStream that catches mid-turn
# assistant text.
# CLAUDE_TAP_POLL_INTERVAL=0.1

# Safety bound (seconds) on the scoped post-tool-use polling task.
# Polling self-stops after this many seconds even if no next hook
# event arrives, so a stuck or idle session does not leak a poll task.
# CLAUDE_TAP_POLL_MAX_DURATION=30

# Visual cell width used by `claude-tap watch-messages` for both
# the emit-time separator line AND the body trim cap. One knob —
# the block reads as a unit so the two stay synced. Default 100.
# CLAUDE_TAP_PRETTY_WIDTH=100
